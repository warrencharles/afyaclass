<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
    
    # If file or folder exists, serve it
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Otherwise, send everything to index.html (React routing)
    # Ensure it's /index.html to avoid issues in sub-routes
    RewriteRule ^ index.html [L]
</IfModule>
